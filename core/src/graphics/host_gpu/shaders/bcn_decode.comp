const uint K_ANCHORS[64] = uint[](
    0x00000F3Fu, 0x0000083Fu, 0x000008FFu, 0x000003FFu, 0x00000F8Fu, 0x00000F3Fu, 0x000003FFu, 0x000008FFu,
    0x00000F8Fu, 0x00000F8Fu, 0x00000F6Fu, 0x00000F6Fu, 0x00000F6Fu, 0x00000F5Fu, 0x00000F3Fu, 0x0000083Fu,
    0x00000F3Fu, 0x00000832u, 0x00000F88u, 0x000003F2u, 0x00000F32u, 0x00000838u, 0x00000F68u, 0x000008AFu,
    0x00000352u, 0x00000F88u, 0x00000682u, 0x00000A62u, 0x00000F88u, 0x00000F58u, 0x00000AF2u, 0x000008F2u,
    0x00000F8Fu, 0x000003FFu, 0x00000F36u, 0x00000A58u, 0x00000A62u, 0x000008A8u, 0x0000098Fu, 0x00000AFFu,
    0x000006F2u, 0x00000F38u, 0x000008F2u, 0x00000F52u, 0x000003F2u, 0x000006FFu, 0x000006FFu, 0x000008F6u,
    0x00000F36u, 0x000003F2u, 0x00000F56u, 0x00000F58u, 0x00000F5Fu, 0x00000F8Fu, 0x00000F52u, 0x00000FA2u,
    0x00000F5Fu, 0x00000FAFu, 0x00000F8Fu, 0x00000FDFu, 0x000003FFu, 0x00000FC2u, 0x00000F32u, 0x0000083Fu
);

// BC7 modes: subsets, partition bits, rotation bits, index selection bits, colour bits,
// alpha bits, per-endpoint p-bits, shared p-bits, primary and secondary index bits.
const uint K_NS[8] = uint[](3, 2, 3, 2, 1, 1, 1, 2);
const uint K_PB[8] = uint[](4, 6, 6, 6, 0, 0, 0, 6);
const uint K_RB[8] = uint[](0, 0, 0, 0, 2, 2, 0, 0);
const uint K_ISB[8] = uint[](0, 0, 0, 0, 1, 0, 0, 0);
const uint K_CB[8] = uint[](4, 6, 5, 7, 5, 7, 7, 5);
const uint K_AB[8] = uint[](0, 0, 0, 0, 6, 8, 7, 5);
const uint K_EPB[8] = uint[](1, 0, 0, 1, 0, 0, 1, 1);
const uint K_SPB[8] = uint[](0, 1, 0, 0, 0, 0, 0, 0);
const uint K_IB[8] = uint[](3, 3, 2, 2, 2, 2, 4, 2);
const uint K_IB2[8] = uint[](0, 0, 0, 0, 3, 2, 0, 0);

const uint K_WEIGHTS_2[4] = uint[](0, 21, 43, 64);
const uint K_WEIGHTS_3[8] = uint[](0, 9, 18, 27, 37, 46, 55, 64);
const uint K_WEIGHTS_4[16] = uint[](0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64);


// The tables in workgroup memory: glslang copies a whole constant array into private memory
// at every dynamically indexed read, which made a 2048x1024 BC7 upload take 1.4 s on Adreno
// (past the GPU timeout). LoadTables fills them once per workgroup.
shared uint PARTITIONS_2[64];
shared uint PARTITIONS_3[64];
shared uint ANCHORS[64];
shared uint NS[8];
shared uint PB[8];
shared uint RB[8];
shared uint ISB[8];
shared uint CB[8];
shared uint AB[8];
shared uint EPB[8];
shared uint SPB[8];
shared uint IB[8];
shared uint IB2[8];
shared uint WEIGHTS_2[4];
shared uint WEIGHTS_3[8];
shared uint WEIGHTS_4[16];

void LoadTables() {
    const uint i = gl_LocalInvocationIndex;
    PARTITIONS_2[i] = K_PARTITIONS_2[i];
    PARTITIONS_3[i] = K_PARTITIONS_3[i];
    ANCHORS[i] = K_ANCHORS[i];
    if (i < 8u) {
        NS[i] = K_NS[i];
    }
    if (i < 8u) {
        PB[i] = K_PB[i];
    }
    if (i < 8u) {
        RB[i] = K_RB[i];
    }
    if (i < 8u) {
        ISB[i] = K_ISB[i];
    }
    if (i < 8u) {
        CB[i] = K_CB[i];
    }
    if (i < 8u) {
        AB[i] = K_AB[i];
    }
    if (i < 8u) {
        EPB[i] = K_EPB[i];
    }
    if (i < 8u) {
        SPB[i] = K_SPB[i];
    }
    if (i < 8u) {
        IB[i] = K_IB[i];
    }
    if (i < 8u) {
        IB2[i] = K_IB2[i];
    }
    if (i < 4u) {
        WEIGHTS_2[i] = K_WEIGHTS_2[i];
    }
    if (i < 8u) {
        WEIGHTS_3[i] = K_WEIGHTS_3[i];
    }
    if (i < 16u) {
        WEIGHTS_4[i] = K_WEIGHTS_4[i];
    }
    barrier();
}

// The raw block. Texels are worked out one at a time straight from it: no per-invocation arrays,
// which some drivers keep in memory that isn't private to the invocation.
uvec4 blk;

uint Pack(uvec4 c) {
    return (c.r & 0xFFu) | ((c.g & 0xFFu) << 8) | ((c.b & 0xFFu) << 16) | ((c.a & 0xFFu) << 24);
}

uvec4 Expand565(uint c) {
    const uint r = (c >> 11) & 0x1Fu;
    const uint g = (c >> 5) & 0x3Fu;
    const uint b = c & 0x1Fu;
    return uvec4((r << 3) | (r >> 2), (g << 2) | (g >> 4), (b << 3) | (b >> 2), 255u);
}

// BC1 colour block; BC2 and BC3 always use the four-colour mode.
uvec4 ColorTexel(uint endpoints, uint indices, bool always_four_colors, uint texel) {
    const uint c0 = endpoints & 0xFFFFu;
    const uint c1 = endpoints >> 16;
    const uvec4 e0 = Expand565(c0);
    const uvec4 e1 = Expand565(c1);
    const uint index = (indices >> (texel * 2u)) & 3u;
    if (index == 0u) {
        return e0;
    }
    if (index == 1u) {
        return e1;
    }
    if (always_four_colors || c0 > c1) {
        return index == 2u ? uvec4((e0.rgb * 2u + e1.rgb) / 3u, 255u)
                           : uvec4((e1.rgb * 2u + e0.rgb) / 3u, 255u);
    }
    return index == 2u ? uvec4((e0.rgb + e1.rgb) >> 1, 255u) : uvec4(0u); // transparent black
}

// BC2 alpha: 4 bits per texel.
uint ExplicitAlpha(uint lo, uint hi, uint texel) {
    const uint a = ((texel < 8u ? lo : hi) >> ((texel & 7u) * 4u)) & 0xFu;
    return a | (a << 4);
}

// C division, rounding towards zero.
int Divide(int n, int d) {
    return n < 0 ? -((-n) / d) : n / d;
}

// BC3 alpha, BC4 and each half of BC5, as a byte (SNORM bytes for signed formats).
uint ChannelTexel(uint lo, uint hi, bool is_snorm, uint texel) {
    int c0;
    int c1;
    if (is_snorm) {
        c0 = int(lo << 24) >> 24;
        c1 = int(lo << 16) >> 24;
    } else {
        c0 = int(lo & 0xFFu);
        c1 = int((lo >> 8) & 0xFFu);
    }
    const uint offset = 16u + texel * 3u;
    uint bits;
    if (offset + 3u <= 32u) {
        bits = lo >> offset;
    } else if (offset >= 32u) {
        bits = hi >> (offset - 32u);
    } else {
        bits = (lo >> offset) | (hi << (32u - offset));
    }
    const int index = int(bits & 7u);
    int value;
    if (index == 0) {
        value = c0;
    } else if (index == 1) {
        value = c1;
    } else if (c0 > c1) {
        value = Divide((8 - index) * c0 + (index - 1) * c1, 7);
    } else if (index < 6) {
        value = Divide((6 - index) * c0 + (index - 1) * c1, 5);
    } else if (index == 6) {
        value = is_snorm ? -128 : 0;
    } else {
        value = is_snorm ? 127 : 255;
    }
    return uint(value) & 0xFFu;
}

uint BlockWord(uint word) {
    return word == 0u ? blk.x : word == 1u ? blk.y : word == 2u ? blk.z : blk.w;
}

uint Bits(uint offset, uint count) {
    if (count == 0u) {
        return 0u;
    }
    const uint word = offset >> 5;
    const uint shift = offset & 31u;
    uint value = BlockWord(word) >> shift;
    if (shift + count > 32u) {
        value |= BlockWord(min(word + 1u, 3u)) << (32u - shift);
    }
    return value & ((1u << count) - 1u);
}

uint Subset(uint subsets, uint partition_index, uint texel) {
    if (subsets == 2u) {
        return (PARTITIONS_2[partition_index] >> (texel * 2u)) & 3u;
    }
    if (subsets == 3u) {
        return (PARTITIONS_3[partition_index] >> (texel * 2u)) & 3u;
    }
    return 0u;
}

uint Weight(uint index, uint bits) {
    // Masked: the compiler may evaluate every arm of a select, and an index meant for one table
    // read out of bounds in the others hung Adreno GPUs (BC7 mode 6, 4-bit indices).
    return bits == 2u ? WEIGHTS_2[index & 3u]
         : bits == 3u ? WEIGHTS_3[index & 7u]
                      : WEIGHTS_4[index & 15u];
}

uint Interpolate(uint e0, uint e1, uint weight) {
    return ((64u - weight) * e0 + weight * e1 + 32u) >> 6;
}

uint Expand(uint value, uint bits) {
    value <<= 8u - bits;
    return value | (value >> bits);
}

// Decoded endpoint `e` of a BC7 block whose endpoints start at `pos`.
uvec4 Bc7Endpoint(uint mode, uint pos, uint e) {
    const uint endpoints = NS[mode] * 2u;
    const uint color_bits = CB[mode];
    const uint alpha_bits = AB[mode];
    uvec4 c = uvec4(Bits(pos + e * color_bits, color_bits),
                    Bits(pos + (endpoints + e) * color_bits, color_bits),
                    Bits(pos + (endpoints * 2u + e) * color_bits, color_bits),
                    Bits(pos + endpoints * 3u * color_bits + e * alpha_bits, alpha_bits));
    const uint p_bits = pos + endpoints * (3u * color_bits + alpha_bits);
    uint rgb_bits = color_bits;
    uint a_bits = alpha_bits;
    if (EPB[mode] != 0u) {
        const uint p = Bits(p_bits + e, 1u);
        c = (c << 1) | p;
        rgb_bits += 1u;
        a_bits += 1u;
    } else if (SPB[mode] != 0u) {
        const uint p = Bits(p_bits + e / 2u, 1u);
        c.rgb = (c.rgb << 1) | p;
        rgb_bits += 1u;
    }
    return uvec4(Expand(c.r, rgb_bits), Expand(c.g, rgb_bits), Expand(c.b, rgb_bits),
                 alpha_bits != 0u ? Expand(c.a, a_bits) : 255u);
}

// The BC7 block state, decoded once per block (Bc7Prepare) and shared by its 16 texels: decoding
// it again for every texel made large BC7 uploads run past the GPU timeout.
bool bc7_valid;
uint bc7_mode;
uint bc7_partition;
uint bc7_rotation;
uint bc7_selection;
uint bc7_subsets;
uint bc7_anchor_1;
uint bc7_anchor_2;
uint bc7_primary_start;
uint bc7_secondary_start;
uvec4 bc7_e0;
uvec4 bc7_e1;
uvec4 bc7_e2;
uvec4 bc7_e3;
uvec4 bc7_e4;
uvec4 bc7_e5;

void Bc7Prepare() {
    const uint mode_bits = blk.x & 0xFFu;
    bc7_valid = mode_bits != 0u;
    if (!bc7_valid) {
        return; // reserved mode: transparent black
    }
    const uint mode = uint(findLSB(mode_bits));
    bc7_mode = mode;
    uint pos = mode + 1u;
    bc7_partition = Bits(pos, PB[mode]);
    pos += PB[mode];
    bc7_rotation = Bits(pos, RB[mode]);
    pos += RB[mode];
    bc7_selection = Bits(pos, ISB[mode]);
    pos += ISB[mode];

    const uint subsets = NS[mode];
    const uint endpoints = subsets * 2u;
    bc7_subsets = subsets;
    bc7_e0 = Bc7Endpoint(mode, pos, 0u);
    bc7_e1 = Bc7Endpoint(mode, pos, 1u);
    bc7_e2 = uvec4(0u);
    bc7_e3 = uvec4(0u);
    bc7_e4 = uvec4(0u);
    bc7_e5 = uvec4(0u);
    if (subsets >= 2u) {
        bc7_e2 = Bc7Endpoint(mode, pos, 2u);
        bc7_e3 = Bc7Endpoint(mode, pos, 3u);
    }
    if (subsets == 3u) {
        bc7_e4 = Bc7Endpoint(mode, pos, 4u);
        bc7_e5 = Bc7Endpoint(mode, pos, 5u);
    }

    // Index bits: the anchor texel of each subset (texel 0, then the tables) has one bit fewer.
    bc7_anchor_1 = subsets == 2u ? ANCHORS[bc7_partition] & 0xFu
                                 : (ANCHORS[bc7_partition] >> 4) & 0xFu;
    bc7_anchor_2 = (ANCHORS[bc7_partition] >> 8) & 0xFu;
    uint p_bits = 0u;
    if (EPB[mode] != 0u) {
        p_bits = endpoints;
    } else if (SPB[mode] != 0u) {
        p_bits = subsets;
    }
    bc7_primary_start = pos + endpoints * (3u * CB[mode] + AB[mode]) + p_bits;
    bc7_secondary_start = bc7_primary_start + 16u * IB[mode] - subsets;
}

uvec4 Bc7Texel(uint texel) {
    if (!bc7_valid) {
        return uvec4(0u);
    }
    const uint mode = bc7_mode;
    const uint subsets = bc7_subsets;
    const uint s = Subset(subsets, bc7_partition, texel);
    const uvec4 e0 = s == 0u ? bc7_e0 : s == 1u ? bc7_e2 : bc7_e4;
    const uvec4 e1 = s == 0u ? bc7_e1 : s == 1u ? bc7_e3 : bc7_e5;

    const bool is_anchor = texel == 0u || (subsets >= 2u && texel == bc7_anchor_1) ||
                           (subsets == 3u && texel == bc7_anchor_2);
    uint anchors_before = texel > 0u ? 1u : 0u;
    if (subsets >= 2u && bc7_anchor_1 < texel) {
        anchors_before += 1u;
    }
    if (subsets == 3u && bc7_anchor_2 < texel) {
        anchors_before += 1u;
    }
    const uint index_bits = IB[mode];
    const uint index_bits_2 = IB2[mode];
    const uint primary = Bits(bc7_primary_start + texel * index_bits - anchors_before,
                              index_bits - (is_anchor ? 1u : 0u));
    uint secondary = 0u;
    if (index_bits_2 != 0u) {
        secondary = Bits(bc7_secondary_start + texel * index_bits_2 - (texel > 0u ? 1u : 0u),
                         index_bits_2 - (texel == 0u ? 1u : 0u));
    }
    const bool color_secondary = bc7_selection == 1u;
    const bool alpha_secondary = index_bits_2 != 0u && bc7_selection == 0u;
    const uint cw = color_secondary ? Weight(secondary, index_bits_2) : Weight(primary, index_bits);
    const uint aw = alpha_secondary ? Weight(secondary, index_bits_2) : Weight(primary, index_bits);
    uvec4 c = uvec4(Interpolate(e0.r, e1.r, cw), Interpolate(e0.g, e1.g, cw),
                    Interpolate(e0.b, e1.b, cw), Interpolate(e0.a, e1.a, aw));
    if (bc7_rotation == 1u) {
        c = c.agbr;
    } else if (bc7_rotation == 2u) {
        c = c.rabg;
    } else if (bc7_rotation == 3u) {
        c = c.rgab;
    }
    return c;
}

// BC6H (BC6H_UF16 / BC6H_SF16), from the format specification. Endpoints are read per mode into
// R, G and B (components 0-3 are endpoints 0-3), transformed and unquantized, then interpolated
// for the texel and turned into half floats.
uint bc6_pos;
uvec4 bc6_r;
uvec4 bc6_g;
uvec4 bc6_b;

uint Bc6Take(uint count) {
    const uint value = Bits(bc6_pos, count);
    bc6_pos += count;
    return value;
}

// Endpoint bits [first + count - 1 : first].
void Bc6Get(inout uint value, uint first, uint count) {
    value |= Bc6Take(count) << first;
}

void Bc6Bit(inout uint value, uint bit) {
    value |= Bc6Take(1u) << bit;
}

// Reads the endpoints of `mode` (1-14); returns the partition index.
uint Bc6ReadEndpoints(uint mode) {
    bc6_r = uvec4(0u);
    bc6_g = uvec4(0u);
    bc6_b = uvec4(0u);
    bc6_pos = mode <= 2u ? 2u : 5u;
    switch (mode) {
    case 1u:
        Bc6Bit(bc6_g.z, 4u); Bc6Bit(bc6_b.z, 4u); Bc6Bit(bc6_b.w, 4u);
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 5u); Bc6Bit(bc6_g.w, 4u); Bc6Get(bc6_g.z, 0u, 4u);
        Bc6Get(bc6_g.y, 0u, 5u); Bc6Bit(bc6_b.w, 0u); Bc6Get(bc6_g.w, 0u, 4u);
        Bc6Get(bc6_b.y, 0u, 5u); Bc6Bit(bc6_b.w, 1u); Bc6Get(bc6_b.z, 0u, 4u);
        Bc6Get(bc6_r.z, 0u, 5u); Bc6Bit(bc6_b.w, 2u); Bc6Get(bc6_r.w, 0u, 5u);
        Bc6Bit(bc6_b.w, 3u);
        break;
    case 2u:
        Bc6Bit(bc6_g.z, 5u); Bc6Bit(bc6_g.w, 4u); Bc6Bit(bc6_g.w, 5u);
        Bc6Get(bc6_r.x, 0u, 7u); Bc6Bit(bc6_b.w, 0u); Bc6Bit(bc6_b.w, 1u); Bc6Bit(bc6_b.z, 4u);
        Bc6Get(bc6_g.x, 0u, 7u); Bc6Bit(bc6_b.z, 5u); Bc6Bit(bc6_b.w, 2u); Bc6Bit(bc6_g.z, 4u);
        Bc6Get(bc6_b.x, 0u, 7u); Bc6Bit(bc6_b.w, 3u); Bc6Bit(bc6_b.w, 5u); Bc6Bit(bc6_b.w, 4u);
        Bc6Get(bc6_r.y, 0u, 6u); Bc6Get(bc6_g.z, 0u, 4u); Bc6Get(bc6_g.y, 0u, 6u);
        Bc6Get(bc6_g.w, 0u, 4u); Bc6Get(bc6_b.y, 0u, 6u); Bc6Get(bc6_b.z, 0u, 4u);
        Bc6Get(bc6_r.z, 0u, 6u); Bc6Get(bc6_r.w, 0u, 6u);
        break;
    case 3u:
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 5u); Bc6Bit(bc6_r.x, 10u); Bc6Get(bc6_g.z, 0u, 4u);
        Bc6Get(bc6_g.y, 0u, 4u); Bc6Bit(bc6_g.x, 10u); Bc6Bit(bc6_b.w, 0u);
        Bc6Get(bc6_g.w, 0u, 4u); Bc6Get(bc6_b.y, 0u, 4u); Bc6Bit(bc6_b.x, 10u);
        Bc6Bit(bc6_b.w, 1u); Bc6Get(bc6_b.z, 0u, 4u); Bc6Get(bc6_r.z, 0u, 5u);
        Bc6Bit(bc6_b.w, 2u); Bc6Get(bc6_r.w, 0u, 5u); Bc6Bit(bc6_b.w, 3u);
        break;
    case 4u:
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 4u); Bc6Bit(bc6_r.x, 10u); Bc6Bit(bc6_g.w, 4u);
        Bc6Get(bc6_g.z, 0u, 4u); Bc6Get(bc6_g.y, 0u, 5u); Bc6Bit(bc6_g.x, 10u);
        Bc6Get(bc6_g.w, 0u, 4u); Bc6Get(bc6_b.y, 0u, 4u); Bc6Bit(bc6_b.x, 10u);
        Bc6Bit(bc6_b.w, 1u); Bc6Get(bc6_b.z, 0u, 4u); Bc6Get(bc6_r.z, 0u, 4u);
        Bc6Bit(bc6_b.w, 0u); Bc6Bit(bc6_b.w, 2u); Bc6Get(bc6_r.w, 0u, 4u);
        Bc6Bit(bc6_g.z, 4u); Bc6Bit(bc6_b.w, 3u);
        break;
    case 5u:
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 4u); Bc6Bit(bc6_r.x, 10u); Bc6Bit(bc6_b.z, 4u);
        Bc6Get(bc6_g.z, 0u, 4u); Bc6Get(bc6_g.y, 0u, 4u); Bc6Bit(bc6_g.x, 10u);
        Bc6Bit(bc6_b.w, 0u); Bc6Get(bc6_g.w, 0u, 4u); Bc6Get(bc6_b.y, 0u, 5u);
        Bc6Bit(bc6_b.x, 10u); Bc6Get(bc6_b.z, 0u, 4u); Bc6Get(bc6_r.z, 0u, 4u);
        Bc6Bit(bc6_b.w, 1u); Bc6Bit(bc6_b.w, 2u); Bc6Get(bc6_r.w, 0u, 4u);
        Bc6Bit(bc6_b.w, 4u); Bc6Bit(bc6_b.w, 3u);
        break;
    case 6u:
        Bc6Get(bc6_r.x, 0u, 9u); Bc6Bit(bc6_b.z, 4u); Bc6Get(bc6_g.x, 0u, 9u);
        Bc6Bit(bc6_g.z, 4u); Bc6Get(bc6_b.x, 0u, 9u); Bc6Bit(bc6_b.w, 4u);
        Bc6Get(bc6_r.y, 0u, 5u); Bc6Bit(bc6_g.w, 4u); Bc6Get(bc6_g.z, 0u, 4u);
        Bc6Get(bc6_g.y, 0u, 5u); Bc6Bit(bc6_b.w, 0u); Bc6Get(bc6_g.w, 0u, 4u);
        Bc6Get(bc6_b.y, 0u, 5u); Bc6Bit(bc6_b.w, 1u); Bc6Get(bc6_b.z, 0u, 4u);
        Bc6Get(bc6_r.z, 0u, 5u); Bc6Bit(bc6_b.w, 2u); Bc6Get(bc6_r.w, 0u, 5u);
        Bc6Bit(bc6_b.w, 3u);
        break;
    case 7u:
        Bc6Get(bc6_r.x, 0u, 8u); Bc6Bit(bc6_g.w, 4u); Bc6Bit(bc6_b.z, 4u);
        Bc6Get(bc6_g.x, 0u, 8u); Bc6Bit(bc6_b.w, 2u); Bc6Bit(bc6_g.z, 4u);
        Bc6Get(bc6_b.x, 0u, 8u); Bc6Bit(bc6_b.w, 3u); Bc6Bit(bc6_b.w, 4u);
        Bc6Get(bc6_r.y, 0u, 6u); Bc6Get(bc6_g.z, 0u, 4u); Bc6Get(bc6_g.y, 0u, 5u);
        Bc6Bit(bc6_b.w, 0u); Bc6Get(bc6_g.w, 0u, 4u); Bc6Get(bc6_b.y, 0u, 5u);
        Bc6Bit(bc6_b.w, 1u); Bc6Get(bc6_b.z, 0u, 4u); Bc6Get(bc6_r.z, 0u, 6u);
        Bc6Get(bc6_r.w, 0u, 6u);
        break;
    case 8u:
        Bc6Get(bc6_r.x, 0u, 8u); Bc6Bit(bc6_b.w, 0u); Bc6Bit(bc6_b.z, 4u);
        Bc6Get(bc6_g.x, 0u, 8u); Bc6Bit(bc6_g.z, 5u); Bc6Bit(bc6_g.z, 4u);
        Bc6Get(bc6_b.x, 0u, 8u); Bc6Bit(bc6_g.w, 5u); Bc6Bit(bc6_b.w, 4u);
        Bc6Get(bc6_r.y, 0u, 5u); Bc6Bit(bc6_g.w, 4u); Bc6Get(bc6_g.z, 0u, 4u);
        Bc6Get(bc6_g.y, 0u, 6u); Bc6Get(bc6_g.w, 0u, 4u); Bc6Get(bc6_b.y, 0u, 5u);
        Bc6Bit(bc6_b.w, 1u); Bc6Get(bc6_b.z, 0u, 4u); Bc6Get(bc6_r.z, 0u, 5u);
        Bc6Bit(bc6_b.w, 2u); Bc6Get(bc6_r.w, 0u, 5u); Bc6Bit(bc6_b.w, 3u);
        break;
    case 9u:
        Bc6Get(bc6_r.x, 0u, 8u); Bc6Bit(bc6_b.w, 1u); Bc6Bit(bc6_b.z, 4u);
        Bc6Get(bc6_g.x, 0u, 8u); Bc6Bit(bc6_b.z, 5u); Bc6Bit(bc6_g.z, 4u);
        Bc6Get(bc6_b.x, 0u, 8u); Bc6Bit(bc6_b.w, 5u); Bc6Bit(bc6_b.w, 4u);
        Bc6Get(bc6_r.y, 0u, 5u); Bc6Bit(bc6_g.w, 4u); Bc6Get(bc6_g.z, 0u, 4u);
        Bc6Get(bc6_g.y, 0u, 5u); Bc6Bit(bc6_b.w, 0u); Bc6Get(bc6_g.w, 0u, 4u);
        Bc6Get(bc6_b.y, 0u, 6u); Bc6Get(bc6_b.z, 0u, 4u); Bc6Get(bc6_r.z, 0u, 5u);
        Bc6Bit(bc6_b.w, 2u); Bc6Get(bc6_r.w, 0u, 5u); Bc6Bit(bc6_b.w, 3u);
        break;
    case 10u:
        Bc6Get(bc6_r.x, 0u, 6u); Bc6Bit(bc6_g.w, 4u); Bc6Bit(bc6_b.w, 0u);
        Bc6Bit(bc6_b.w, 1u); Bc6Bit(bc6_b.z, 4u); Bc6Get(bc6_g.x, 0u, 6u);
        Bc6Bit(bc6_g.z, 5u); Bc6Bit(bc6_b.z, 5u); Bc6Bit(bc6_b.w, 2u);
        Bc6Bit(bc6_g.z, 4u); Bc6Get(bc6_b.x, 0u, 6u); Bc6Bit(bc6_g.w, 5u);
        Bc6Bit(bc6_b.w, 3u); Bc6Bit(bc6_b.w, 5u); Bc6Bit(bc6_b.w, 4u);
        Bc6Get(bc6_r.y, 0u, 6u); Bc6Get(bc6_g.z, 0u, 4u); Bc6Get(bc6_g.y, 0u, 6u);
        Bc6Get(bc6_g.w, 0u, 4u); Bc6Get(bc6_b.y, 0u, 6u); Bc6Get(bc6_b.z, 0u, 4u);
        Bc6Get(bc6_r.z, 0u, 6u); Bc6Get(bc6_r.w, 0u, 6u);
        break;
    case 11u:
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 10u); Bc6Get(bc6_g.y, 0u, 10u); Bc6Get(bc6_b.y, 0u, 10u);
        break;
    case 12u:
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 9u); Bc6Bit(bc6_r.x, 10u); Bc6Get(bc6_g.y, 0u, 9u);
        Bc6Bit(bc6_g.x, 10u); Bc6Get(bc6_b.y, 0u, 9u); Bc6Bit(bc6_b.x, 10u);
        break;
    case 13u:
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 8u); Bc6Bit(bc6_r.x, 11u); Bc6Bit(bc6_r.x, 10u);
        Bc6Get(bc6_g.y, 0u, 8u); Bc6Bit(bc6_g.x, 11u); Bc6Bit(bc6_g.x, 10u);
        Bc6Get(bc6_b.y, 0u, 8u); Bc6Bit(bc6_b.x, 11u); Bc6Bit(bc6_b.x, 10u);
        break;
    default: // 14: the high bits of endpoint 0 are stored from bit 15 down to bit 10
        Bc6Get(bc6_r.x, 0u, 10u); Bc6Get(bc6_g.x, 0u, 10u); Bc6Get(bc6_b.x, 0u, 10u);
        Bc6Get(bc6_r.y, 0u, 4u);
        for (uint bit = 15u; bit >= 10u; --bit) Bc6Bit(bc6_r.x, bit);
        Bc6Get(bc6_g.y, 0u, 4u);
        for (uint bit = 15u; bit >= 10u; --bit) Bc6Bit(bc6_g.x, bit);
        Bc6Get(bc6_b.y, 0u, 4u);
        for (uint bit = 15u; bit >= 10u; --bit) Bc6Bit(bc6_b.x, bit);
        break;
    }
    return mode <= 10u ? Bc6Take(5u) : 0u;
}

int SignExtend(uint value, uint bits) {
    return int(value << (32u - bits)) >> (32u - bits);
}

// Endpoints of one channel: transformed (deltas from endpoint 0) or direct, sign-extended for
// SF16, then unquantized.
ivec4 Bc6Endpoints(uvec4 raw, uint endpoint_bits, uint delta_bits, bool transformed,
                   bool is_snorm) {
    const uint mask = (1u << endpoint_bits) - 1u;
    ivec4 e;
    e.x = is_snorm ? SignExtend(raw.x, endpoint_bits) : int(raw.x);
    for (int i = 1; i < 4; ++i) {
        uint value = raw[i];
        if (transformed) {
            value = (raw.x + uint(SignExtend(raw[i], delta_bits))) & mask;
        }
        e[i] = is_snorm ? SignExtend(value, endpoint_bits) : int(value);
    }
    for (int i = 0; i < 4; ++i) {
        int v = e[i];
        if (!is_snorm) {
            if (endpoint_bits < 15u) {
                v = v == 0 ? 0
                  : v == int(mask) ? 0xFFFF
                  : ((v << 16) + 0x8000) >> int(endpoint_bits);
            }
        } else if (endpoint_bits < 16u) {
            const bool negative = v < 0;
            int magnitude = abs(v);
            if (magnitude != 0) {
                magnitude = magnitude >= (1 << (endpoint_bits - 1u)) - 1
                                ? 0x7FFF
                                : ((magnitude << 15) + 0x4000) >> int(endpoint_bits - 1u);
            }
            v = negative ? -magnitude : magnitude;
        }
        e[i] = v;
    }
    return e;
}

uint Bc6Finish(int value, bool is_snorm) {
    if (!is_snorm) {
        return uint((value * 31) >> 6) & 0xFFFFu;
    }
    return value < 0 ? ((uint((-value) * 31) >> 5) | 0x8000u) : uint((value * 31) >> 5);
}

// The BC6H block state, decoded once per block (Bc6Prepare) and shared by its 16 texels.
bool bc6_valid;
uint bc6_mode;
uint bc6_shape;
ivec4 bc6_er;
ivec4 bc6_eg;
ivec4 bc6_eb;

void Bc6Prepare() {
    const bool is_snorm = is_signed != 0u;
    const uint low = blk.x & 0x1Fu;
    uint mode = 0u;
    if ((low & 3u) < 2u) {
        mode = (low & 3u) + 1u;
    } else {
        switch (low) {
        case 0x02u: mode = 3u; break;
        case 0x06u: mode = 4u; break;
        case 0x0Au: mode = 5u; break;
        case 0x0Eu: mode = 6u; break;
        case 0x12u: mode = 7u; break;
        case 0x16u: mode = 8u; break;
        case 0x1Au: mode = 9u; break;
        case 0x1Eu: mode = 10u; break;
        case 0x03u: mode = 11u; break;
        case 0x07u: mode = 12u; break;
        case 0x0Bu: mode = 13u; break;
        case 0x0Fu: mode = 14u; break;
        default: break; // reserved
        }
    }
    bc6_valid = mode != 0u;
    if (!bc6_valid) {
        return;
    }
    bc6_mode = mode;
    // Endpoint bits, then delta bits per channel; modes 10 and 11 are not transformed.
    const uint EPB[15] = uint[](0, 10, 7, 11, 11, 11, 9, 8, 8, 8, 6, 10, 11, 12, 16);
    const uint DR[15] = uint[](0, 5, 6, 5, 4, 4, 5, 6, 5, 5, 6, 10, 9, 8, 4);
    const uint DG[15] = uint[](0, 5, 6, 4, 5, 4, 5, 5, 6, 5, 6, 10, 9, 8, 4);
    const uint DB[15] = uint[](0, 5, 6, 4, 4, 5, 5, 5, 5, 6, 6, 10, 9, 8, 4);
    const bool transformed = mode != 10u && mode != 11u;
    bc6_shape = Bc6ReadEndpoints(mode);
    bc6_er = Bc6Endpoints(bc6_r, EPB[mode], DR[mode], transformed, is_snorm);
    bc6_eg = Bc6Endpoints(bc6_g, EPB[mode], DG[mode], transformed, is_snorm);
    bc6_eb = Bc6Endpoints(bc6_b, EPB[mode], DB[mode], transformed, is_snorm);
}

// The texel as half-float RGB with alpha 1.0: red | green << 16, blue | 1.0 << 16.
uvec2 Bc6hTexel(uint texel) {
    if (!bc6_valid) {
        return uvec2(0u, 0x3C000000u); // reserved mode: black
    }
    const bool is_snorm = is_signed != 0u;
    uint subset = 0u;
    uint weight;
    if (bc6_mode <= 10u) {
        // Two regions share BC7's first 32 two-subset partitions; 3-bit indices from bit 82.
        subset = Subset(2u, bc6_shape, texel);
        const uint anchor = ANCHORS[bc6_shape] & 0xFu;
        const bool is_anchor = texel == 0u || texel == anchor;
        uint before = texel > 0u ? 1u : 0u;
        if (anchor < texel) {
            before += 1u;
        }
        weight = WEIGHTS_3[Bits(82u + texel * 3u - before, is_anchor ? 2u : 3u)];
    } else {
        weight = WEIGHTS_4[Bits(65u + texel * 4u - (texel > 0u ? 1u : 0u), texel == 0u ? 3u : 4u)];
    }
    const int e0 = int(subset * 2u);
    const int w = int(weight);
    const int cr = (bc6_er[e0] * (64 - w) + bc6_er[e0 + 1] * w + 32) >> 6;
    const int cg = (bc6_eg[e0] * (64 - w) + bc6_eg[e0 + 1] * w + 32) >> 6;
    const int cb = (bc6_eb[e0] * (64 - w) + bc6_eb[e0 + 1] * w + 32) >> 6;
    return uvec2(Bc6Finish(cr, is_snorm) | (Bc6Finish(cg, is_snorm) << 16),
                 Bc6Finish(cb, is_snorm) | 0x3C000000u);
}

// The texel as RGBA8 (BC1/2/3/7), R8 (BC4) or RG8 (BC5) in the low bytes.
uint DecodeTexel(uint texel) {
    const bool is_snorm = is_signed != 0u;
    switch (format) {
    case FORMAT_BC1:
        return Pack(ColorTexel(blk.x, blk.y, false, texel));
    case FORMAT_BC2:
        return Pack(uvec4(ColorTexel(blk.z, blk.w, true, texel).rgb,
                          ExplicitAlpha(blk.x, blk.y, texel)));
    case FORMAT_BC3:
        return Pack(uvec4(ColorTexel(blk.z, blk.w, true, texel).rgb,
                          ChannelTexel(blk.x, blk.y, false, texel)));
    case FORMAT_BC4:
        return ChannelTexel(blk.x, blk.y, is_snorm, texel);
    case FORMAT_BC5:
        return ChannelTexel(blk.x, blk.y, is_snorm, texel) |
               (ChannelTexel(blk.z, blk.w, is_snorm, texel) << 8);
    default:
        return Pack(Bc7Texel(texel));
    }
}

void main() {
    // Before any invocation returns: the barrier needs the whole workgroup.
    if (format == FORMAT_BC6 || format == FORMAT_BC7) {
        LoadTables();
    }
    const uint block_index = gl_GlobalInvocationID.x;
    const uint blocks_per_slice = blocks_x * blocks_y;
    if (block_index >= blocks_per_slice * slices) {
        return;
    }
    const uint slice = block_index / blocks_per_slice;
    const uint in_slice = block_index % blocks_per_slice;
    const uint bx = in_slice % blocks_x;
    const uint by = in_slice / blocks_x;

    const bool is_16_bytes = format != FORMAT_BC1 && format != FORMAT_BC4;
    const uint base = input_offset + block_index * (is_16_bytes ? 4u : 2u);
    // A branch, not a select: the compiler may evaluate both arms of a select, and the last
    // 8-byte block's extra words lie past the end of the buffer (a GPU fault on Adreno).
    blk = uvec4(blocks[base], blocks[base + 1u], 0u, 0u);
    if (is_16_bytes && base + 3u < uint(blocks.length())) {
        blk.z = blocks[base + 2u];
        blk.w = blocks[base + 3u];
    }
    if (debug_mode == 1u) {
        // All-zero words, as the clear used when nothing is decoded.
        const uint words = format == FORMAT_BC6 ? 8u : format == FORMAT_BC4 ? 1u : format == FORMAT_BC5 ? 2u : 4u;
        for (uint y = 0; y < 4u; ++y) {
            const uint row = (slice * blocks_y + by) * 4u + y;
            for (uint word = 0; word < words; ++word) {
                texels[output_offset + row * blocks_x * words + bx * words + word] = 0u;
            }
        }
        return;
    }
    if (format == FORMAT_BC7) {
        Bc7Prepare();
    } else if (format == FORMAT_BC6) {
        Bc6Prepare();
    }

    if (format == FORMAT_BC6) {
        // RGBA16F: two words per texel.
        const uint row_words = blocks_x * 8u;
        for (uint y = 0; y < 4u; ++y) {
            const uint row = (slice * blocks_y + by) * 4u + y;
            const uint out_base = output_offset + row * row_words + bx * 8u;
            for (uint x = 0; x < 4u; ++x) {
                const uvec2 t = Bc6hTexel(y * 4u + x);
                texels[out_base + x * 2u] = t.x;
                texels[out_base + x * 2u + 1u] = t.y;
            }
        }
        return;
    }
    const uint bytes_per_texel = format == FORMAT_BC4 ? 1u : format == FORMAT_BC5 ? 2u : 4u;
    const uint row_words = blocks_x * bytes_per_texel;
    for (uint y = 0; y < 4u; ++y) {
        const uint row = (slice * blocks_y + by) * 4u + y;
        const uint out_base = output_offset + row * row_words + bx * bytes_per_texel;
        const uint t0 = DecodeTexel(y * 4u);
        const uint t1 = DecodeTexel(y * 4u + 1u);
        const uint t2 = DecodeTexel(y * 4u + 2u);
        const uint t3 = DecodeTexel(y * 4u + 3u);
        if (bytes_per_texel == 4u) {
            texels[out_base] = t0;
            texels[out_base + 1u] = t1;
            texels[out_base + 2u] = t2;
            texels[out_base + 3u] = t3;
        } else if (bytes_per_texel == 2u) {
            texels[out_base] = t0 | (t1 << 16);
            texels[out_base + 1u] = t2 | (t3 << 16);
        } else {
            texels[out_base] = t0 | (t1 << 8) | (t2 << 16) | (t3 << 24);
        }
    }
}
