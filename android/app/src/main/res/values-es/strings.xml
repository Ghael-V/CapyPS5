    <string name="option_upscaler">Escalado</string>
    <string name="option_upscaler_desc">Cómo se escala la imagen del juego a la pantalla cuando se renderiza a menos resolución. FSR 1 y Snapdragon GSR mantienen nítidos los bordes; Bicúbico es más suave y Vecino más cercano deja píxeles cuadrados. Predeterminado es el escalado bilineal de siempre</string>
    <string name="upscaler_default">Predeterminado</string>
    <string name="upscaler_nearest">Vecino más cercano</string>
    <string name="upscaler_bicubic">Bicúbico</string>
    <string name="upscaler_fsr1">FSR 1</string>
    <string name="upscaler_sgsr1">Snapdragon GSR</string>
    <string name="option_sharpening">Nitidez</string>
    <string name="option_sharpening_desc">Afina la imagen después del escalado (AMD FidelityFX RCAS), sin halos. Va bien junto con una resolución más baja</string>
