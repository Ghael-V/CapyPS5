    <!-- Opciones del núcleo -->
    <string name="option_resolution">Resolución interna</string>
    <string name="option_resolution_desc">Por eje: un juego 4K al 50 % se dibuja a 1080p (un cuarto del trabajo). Menos resolución alivia la GPU; algunos juegos no la admiten. Se aplica al volver a abrir el juego</string>
    <string name="resolution_native">Nativa</string>
    <string name="resolution_75">75 % (4K → 1620p)</string>
    <string name="resolution_50">50 % (4K → 1080p)</string>
    <string name="resolution_33">33 % (4K → 720p)</string>
    <string name="resolution_25">25 % (4K → 540p)</string>
    <string name="ue_resolution">Resolución por defecto para juegos Unreal</string>
    <string name="ue_resolution_desc">Los juegos de Unreal Engine dibujan casi a 4K y van lentos en GPUs de móvil; se usa salvo que el juego tenga su propio ajuste</string>
    <string name="ue_value">Unreal (%1$s)</string>
    <string name="option_async_shaders">Compilar shaders en segundo plano</string>
    <string name="option_async_shaders_desc">Evita tirones; un objeto puede tardar un instante en aparecer</string>
    <string name="option_shadows">Resolución de sombras</string>
    <string name="option_shadows_desc">Dibuja los mapas de sombras más pequeños, aparte de la resolución interna. Las sombras se ven más suaves o pixeladas; no afecta a los motores que dibujan sombras con compute (Unreal Engine 5). Se aplica al volver a abrir el juego</string>
    <string name="shadows_full">Completa</string>
    <string name="shadows_half">50 %</string>
    <string name="shadows_quarter">25 %</string>
    <string name="option_early_depth">Test de profundidad temprano</string>
    <string name="option_early_depth_desc">Deja que la GPU descarte los píxeles ocultos antes de sombrearlos cuando el juego lo permite. Más rápido en escenas con mucha superposición; con algunos drivers Adreno pueden desaparecer objetos en bloques pequeños. Se aplica al volver a abrir el juego</string>
    <string name="option_frame_limit">Límite de FPS</string>
    <string name="option_frame_limit_desc">Limita las imágenes por segundo que muestra el juego. 30 estables se sienten mejor que unos FPS que saltan entre 25 y 40, y dejan margen a la GPU</string>
    <string name="frame_limit_off">El del juego</string>
    <string name="frame_limit_30">30 FPS</string>
    <string name="frame_limit_20">20 FPS</string>
    <string name="option_frame_gen">CapyPS5 Framegen</string>
    <string name="option_frame_gen_desc">Dibuja fotogramas extra entre los del juego para que se vea más fluido. x2 duplica los FPS (de 30 a 60), x3 los triplica (de 20 a 60) y x4 los cuadruplica (de 15 a 60); nunca pasa de la frecuencia de la pantalla. Añade un fotograma de latencia y algo de carga a la GPU</string>
    <string name="frame_gen_x2">Framegen x2</string>
    <string name="frame_gen_x3">Framegen x3</string>
    <string name="frame_gen_x4">Framegen x4</string>

