    <!-- Core options -->
    <string name="option_resolution">Internal resolution</string>
    <string name="option_resolution_desc">Per axis: a 4K game at 50 % renders at 1080p (a quarter of the work). Lower resolution relieves the GPU; some games do not support it. Applies the next time the game starts</string>
    <string name="resolution_native">Native</string>
    <string name="resolution_75">75 % (4K → 1620p)</string>
    <string name="resolution_50">50 % (4K → 1080p)</string>
    <string name="resolution_33">33 % (4K → 720p)</string>
    <string name="resolution_25">25 % (4K → 540p)</string>
    <string name="ue_resolution">Default resolution for Unreal games</string>
    <string name="ue_resolution_desc">Unreal Engine games render near 4K and are slow on mobile GPUs; used unless the game has its own setting</string>
    <string name="ue_value">Unreal (%1$s)</string>
    <string name="option_async_shaders">Compile shaders in the background</string>
    <string name="option_async_shaders_desc">Avoids stutter; an object may take a moment to appear</string>
    <string name="option_shadows">Shadow resolution</string>
    <string name="option_shadows_desc">Renders shadow maps smaller, independently of the internal resolution. Shadows look softer or blockier; engines that draw shadows with compute shaders (Unreal Engine 5) are not affected. Applies the next time the game starts</string>
    <string name="shadows_full">Full</string>
    <string name="shadows_half">50 %</string>
    <string name="shadows_quarter">25 %</string>
    <string name="option_early_depth">Early depth test</string>
    <string name="option_early_depth_desc">Lets the GPU skip hidden pixels before shading them when the game allows it. Faster in scenes with a lot of overdraw; on some Adreno drivers objects may vanish in small blocks. Applies the next time the game starts</string>
    <string name="option_frame_limit">Frame rate limit</string>
    <string name="option_frame_limit_desc">Caps the frames the game shows per second. A steady 30 is smoother than a framerate that jumps between 25 and 40, and leaves the GPU some headroom</string>
    <string name="frame_limit_off">Game default</string>
    <string name="frame_limit_30">30 FPS</string>
    <string name="frame_limit_20">20 FPS</string>
    <string name="option_frame_gen">CapyPS5 Framegen</string>
    <string name="option_frame_gen_desc">Draws extra frames between the game’s own, so it looks smoother. x2 doubles the frame rate (30 to 60), x3 triples it (20 to 60), x4 quadruples it (15 to 60); it never goes past the screen refresh rate. Adds one frame of latency and some GPU load</string>
    <string name="frame_gen_x2">Framegen x2</string>
    <string name="frame_gen_x3">Framegen x3</string>
    <string name="frame_gen_x4">Framegen x4</string>

