    <string name="upscaler_fsr1">FSR 1</string>
    <string name="upscaler_sgsr1">Snapdragon GSR</string>
    <string name="option_sharpening">Sharpening</string>
    <string name="option_sharpening_desc">Sharpens the image after scaling (AMD FidelityFX RCAS), without halos. Good together with a lower resolution</string>
